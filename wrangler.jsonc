{
  /**
   * Cloudflare Workers Configuration (wrangler.jsonc)
   * Educational note: Configures scheduled Cron triggers for automated daily GTFS Static 
   * timetable ingestion and declares KV storage bindings.
   */
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kyiv-transport-tracker",
  "main": "worker.js",
  "compatibility_date": "2024-01-01",
  "triggers": {
    "crons": [
      // Daily automated synchronization at 03:00 UTC (during low transit frequency hours)
      "0 3 * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "TRANSPORT_KV",
      "id": "kyiv_transport_kv_production"
    }
  ],
  "observability": {
    "enabled": true
  }
}
