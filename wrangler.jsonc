{
  /**
   * Cloudflare Workers Configuration (wrangler.jsonc)
   * Educational note: Runs in lightweight Edge execution mode without requiring 
   * external KV namespace provisioning, utilizing native Cloudflare Edge Cache API.
   */
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kpt",
  "main": "worker.js",
  "compatibility_date": "2024-01-01",
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
